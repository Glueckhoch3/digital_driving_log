# Example environment variables for Digidrivelog backend
# Adjust these values as needed

# Application configuration
PORT=8080
# current options: dev, prod
SPRING_PROFILES_ACTIVE=dev
# Comma-separated list of allowed CORS origins.
#   http://localhost:4200,http://192.168.178.25:4200
#   http://192.168.178.*:4200      -> whole 192.168.178.0/24 subnet on port 4200
ALLOWED_ORIGINS=http://localhost:4200,http://192.168.178.*:4200

# Database configuration
POSTGRES_USER=digidrivelog
POSTGRES_PASSWORD=digidrivelog
POSTGRES_DB=digidrivelog
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
